# Reverse proxy for the whole stack — TWO public hosts:
#
#   flmanbiosci.net (+ www)       → marketing site (fmb-website)
#   app.flmanbiosci.net           → tracking app (Next.js frontend)
#   app.flmanbiosci.net/api/*     → FastAPI api
#
# Each "site address" is env-driven so dev and prod can share one file.
#
#   Dev (default):
#       MARKETING_ADDRESS=:80     APP_ADDRESS=:81
#       Open http://localhost  and http://localhost:81
#
#   Prod (in .env):
#       MARKETING_ADDRESS="flmanbiosci.net, www.flmanbiosci.net"
#       APP_ADDRESS="app.flmanbiosci.net"
#       Caddy auto-provisions Let's Encrypt for both.
#
# NOTE: For HTTP-01 ACME to work, point Cloudflare DNS at the VPS in
# "DNS only" (grey cloud) mode. Orange-cloud proxying terminates TLS at
# Cloudflare and blocks Let's Encrypt.

# ───── Marketing site (apex + www) ─────
{$MARKETING_ADDRESS::80} {
    encode zstd gzip

    @www host www.flmanbiosci.net
    redir @www https://flmanbiosci.net{uri} permanent

    reverse_proxy website:80

    log {
        output stdout
        format console
    }
}

# ───── Tracking app + API ─────
{$APP_ADDRESS::81} {
    encode zstd gzip

    @api path /api/*
    handle @api {
        reverse_proxy api:8000
    }

    handle {
        reverse_proxy frontend:3000
    }

    log {
        output stdout
        format console
    }
}
