# Reverse proxy for the engine stack — ONE public host:
#
#   flmanbiosci.net (+ www → apex redirect)  → tracking app (Next.js frontend)
#   flmanbiosci.net/api/v1/*                 → FastAPI api
#
# Dev (default):   SITE_ADDRESS=:80    (open http://localhost)
# Prod (.env):     SITE_ADDRESS="flmanbiosci.net, www.flmanbiosci.net"
#                  Caddy auto-provisions Let's Encrypt for both.
#
# NOTE: For HTTP-01 ACME to work, point Cloudflare DNS at the VPS in
# "DNS only" (grey cloud) mode. Orange-cloud proxying terminates TLS at
# Cloudflare and blocks Let's Encrypt.

{$SITE_ADDRESS::80} {
	encode zstd gzip

	@www host www.flmanbiosci.net
	redir @www https://flmanbiosci.net{uri} permanent

	# Security headers — applied to every response from this host.
	# frame-ancestors blocks clickjacking, which matters here because the
	# /login page would otherwise be embeddable in a hostile iframe and
	# used as a credential-phishing overlay. The other headers are
	# defence-in-depth for a token-in-localStorage SPA.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Tell upstream proxies the response varies on Authorization so
		# they don't cache an authenticated response and serve it to
		# the next, anonymous client.
		Vary "Authorization"
	}

	# API: strip the /api/v1 prefix before proxying to FastAPI. The
	# backend's routes live at /auth/*, /tracking/*, /jobs/*, etc — not
	# under /api/v1 — so without ``handle_path`` (which matches AND
	# strips the prefix), every request would 404. Authorization and
	# other client headers pass through untouched.
	handle_path /api/v1/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}
