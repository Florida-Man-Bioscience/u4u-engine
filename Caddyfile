# Single-entry reverse proxy for the whole stack.
#
#   /api/*       → api      (FastAPI)
#   /tracking*   → frontend (Next.js tracking app)
#   /_next/*     → frontend (Next.js chunks/assets)
#   everything   → website  (marketing site)
#
# SITE_ADDRESS controls how Caddy binds:
#   dev:  SITE_ADDRESS=":80"                                 (default)
#   prod: SITE_ADDRESS="flmanbiosci.net, www.flmanbiosci.net"
# In production Caddy auto-provisions Let's Encrypt for the listed hosts.

{$SITE_ADDRESS::80} {
    encode zstd gzip

    # Redirect www → apex (only fires when the request actually arrives on
    # the www host, so this is a no-op in dev where SITE_ADDRESS is ":80").
    @www host www.flmanbiosci.net
    redir @www https://flmanbiosci.net{uri} permanent

    @api path /api/*
    handle @api {
        reverse_proxy api:8000
    }

    @frontend path /tracking* /_next/*
    handle @frontend {
        reverse_proxy frontend:3000
    }

    handle {
        reverse_proxy website:80
    }

    log {
        output stdout
        format console
    }
}
