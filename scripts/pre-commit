#!/usr/bin/env bash
# Auto-increment patch version in frontend/version.json before each commit.
# Only bumps if there are staged changes beyond version.json itself.

VERSION_FILE="frontend/version.json"

# Skip if version.json doesn't exist
[ -f "$VERSION_FILE" ] || exit 0

# Read current version
CURRENT=$(grep -oP '"version":\s*"\K[^"]+' "$VERSION_FILE")
if [ -z "$CURRENT" ]; then
  exit 0
fi

# Split into major.minor.patch
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"
PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${PATCH}"

# Write new version
printf '{ "version": "%s" }\n' "$NEW_VERSION" > "$VERSION_FILE"

# Stage the updated version file
git add "$VERSION_FILE"

echo "Version bumped: $CURRENT -> $NEW_VERSION"
