# ── U4U Engine Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# NCBI API key — optional but recommended.
# Raises ClinVar rate limit from 3 to 10 requests/second.
# Get one free at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Path to rsID filter files inside the container (default: data)
# DATA_DIR=data

# Comma-separated filter filenames (default: acmg81_rsids.txt)
# Set to empty string to run all variants without a panel filter.
# FILTERS=acmg81_rsids.txt

# Thread pool size for concurrent pipeline runs (default: 4)
# WORKERS=4

# Maximum upload file size in megabytes (default: 100)
# MAX_UPLOAD_MB=100

# Hours to keep completed jobs in memory before cleanup (default: 24)
# JOB_TTL_HOURS=24

# Frontend API base URL — set this when running the frontend container
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── Security ──────────────────────────────────────────────────────────────────
# API authentication. All endpoints except /health require a valid key, sent as
# "Authorization: Bearer <key>" or "X-API-Key: <key>". Comma-separate multiple
# keys. The server FAILS CLOSED: with no keys set it rejects protected requests.
# API_KEYS=changeme-key-1,changeme-key-2

# Local-dev/test escape hatch — set to 1 to disable auth entirely. NEVER enable
# in production.
# ALLOW_INSECURE_NO_AUTH=0

# Username/password login. Set these on first deploy to seed a single admin
# user; the frontend /login page then exchanges these for an opaque session
# token. Subsequent edits are IGNORED — the seed only fires when the users
# table is empty, so an operator can't silently rotate a live account by
# editing env. To change the password, log in and use the change-password
# flow (TODO), or wipe data/auth.db.
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_PASSWORD=changeme-please

# Session token lifetime in days (default 7).
# AUTH_SESSION_TTL_DAYS=7

# Override the auth SQLite path (default: ${DATA_DIR}/auth.db).
# AUTH_DB_PATH=data/auth.db

# Fernet key used to encrypt the on-disk job store (which holds genomic-derived
# results). Without it, results are kept in memory only and never written to
# disk. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JOB_STORE_KEY=

# Optional path to a validated conformal calibration set for PGx drug-response
# predictions. Without it, prediction sets are returned as "uncalibrated"
# (no confidence guarantee).
# PGX_CONFORMAL_CALIBRATION=data/pgx/conformal_calibration.json

# ── Genome build / liftover ───────────────────────────────────────────────────
# By default, coordinate files (VCF) on a confirmed non-GRCh38 build are
# REJECTED. Set ENABLE_LIFTOVER=1 to instead lift GRCh37 coordinates to GRCh38
# (requires the optional 'pyliftover' package). Liftover is an analytical step
# that must be validated before clinical use.
# ENABLE_LIFTOVER=0
# Optional local hg19->hg38 chain file (else pyliftover fetches it from UCSC).
# LIFTOVER_CHAIN_37_TO_38=

# ── Reverse proxy (Caddy) ─────────────────────────────────────────────────────
# Drives the `proxy` service in docker-compose.yml. Default is sane for local
# development (Caddy listens on :80).
#
# For production, set this to the real hostnames; Caddy will then auto-provision
# Let's Encrypt certs for each. Cloudflare DNS records for the listed hosts
# must be in "DNS only" (grey cloud) mode — orange-cloud proxying blocks the
# HTTP-01 challenge.
#
# SITE_ADDRESS="flmanbiosci.net, www.flmanbiosci.net"

# Browser-side API base URL baked into the frontend bundle at build time.
# When the app is served behind Caddy at flmanbiosci.net, set this to a
# relative path so calls go to the same origin (`/api/v1/*` routes to the api
# container inside the Caddy block).
# NEXT_PUBLIC_API_BASE=/api/v1
