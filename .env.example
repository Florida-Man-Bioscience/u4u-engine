# ── U4U Engine Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# NCBI API key — optional but recommended.
# Raises ClinVar rate limit from 3 to 10 requests/second.
# Get one free at: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string. When set, the engine uses Postgres for the
# annotation cache, rsID cache, biomarker tracking, and job store, and runs
# db/migrate.py on startup. When UNSET, the engine falls back to local SQLite
# files under data/ (fine for tests and quick local runs).
#
# The HealthKit ingestion module (engine/health, for the peptodyssey iOS app)
# also uses this same value: it derives an async (postgresql+asyncpg://) URL
# from it, so a single DATABASE_URL drives both the sync psycopg2 stack and the
# async health datastore against one Postgres. When unset, the /health-samples
# endpoints return 503.
#
# docker-compose.yml provides a local `postgres` service and defaults
# DATABASE_URL to it, so you usually do NOT need to set this for compose.
# Set it here only to point at a different database (e.g. a native run
# outside compose, or a remote instance).
#   postgresql://u4u:u4u_dev_password@localhost:5432/u4u?sslmode=disable
# DATABASE_URL=

# Path to rsID filter files inside the container (default: data)
# DATA_DIR=data

# Comma-separated filter filenames (default: acmg81_rsids.txt)
# Set to empty string to run all variants without a panel filter.
# FILTERS=acmg81_rsids.txt

# Thread pool size for concurrent pipeline runs (default: 4)
# WORKERS=4

# Maximum upload file size in megabytes (default: 100)
# MAX_UPLOAD_MB=100

# Hours to keep completed jobs in memory before cleanup (default: 24)
# JOB_TTL_HOURS=24

# Frontend API base URL — set this when running the frontend container
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── Job-store encryption ─────────────────────────────────────────────────────
# Fernet key used to encrypt the on-disk job store (which holds genomic-derived
# results). Without it, results are kept in memory only and never written to
# disk. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# JOB_STORE_KEY=

# Optional path to a validated conformal calibration set for PGx drug-response
# predictions. Without it, prediction sets are returned as "uncalibrated"
# (no confidence guarantee).
# PGX_CONFORMAL_CALIBRATION=data/pgx/conformal_calibration.json

# ── Genome build / liftover ───────────────────────────────────────────────────
# By default, coordinate files (VCF) on a confirmed non-GRCh38 build are
# REJECTED. Set ENABLE_LIFTOVER=1 to instead lift GRCh37 coordinates to GRCh38
# (requires the optional 'pyliftover' package). Liftover is an analytical step
# that must be validated before clinical use.
# ENABLE_LIFTOVER=0
# Optional local hg19->hg38 chain file (else pyliftover fetches it from UCSC).
# LIFTOVER_CHAIN_37_TO_38=

# ── Browser-side API base URL ────────────────────────────────────────────────
# Baked into the frontend bundle at build time. When the app is served behind
# an external reverse proxy that exposes the api at /api/v1/*, set this to the
# relative path so calls go to the same origin. Locally, leave it unset and
# the compose default `http://localhost:8000` is used.
# NEXT_PUBLIC_API_BASE=/api/v1

# ── HealthKit self-service enrollment ─────────────────────────────────────────
# Comma-separated invite codes the peptodyssey app exchanges (with its opaque
# subjectId) at POST /healthkit/enroll for a bound device token — so new users
# onboard without a hand-minted token. Unset ⇒ enrollment endpoint disabled (503).
# HEALTHKIT_ENROLL_CODES=study-2026-abc,study-2026-def
